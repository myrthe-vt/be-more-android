# BMO local configuration example
#
# Copy this file to .env and replace example values locally.
# Never commit your real .env file.

# Optional homelab diagnostics.
# Leave blank to disable remote checks safely.
BMO_HOMELAB_PRIMARY_HOST=
BMO_HOMELAB_MEDIA_HOST=

# Optional Spotify Web API support.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional speech-to-text overrides.
# WHISPER_MODEL=
# WHISPER_THREADS=4

# Optional Hailo features.
# BMO_NPU_STT=0
# VLM_HEF_PATH=
# WHISPER_HEF_PATH=
